# 站点配置
APP_NAME=LinkHub
APP_URL=http://localhost
APP_ENV=production
APP_DEBUG=false

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linkhub_db
DB_USER=root
DB_PASS=
DB_PREFIX=lh_

# AI 配置
AI_PROVIDER=openai
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL=gpt-3.5-turbo
AI_DAILY_LIMIT=100

# 会话配置
SESSION_LIFETIME=7200

# 缓存配置
CACHE_DRIVER=file
